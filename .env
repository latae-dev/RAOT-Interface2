APP_ENV=dev

# พอร์ตเว็บบนเครื่อง host (docker-compose) — 8080 ถูกใช้โดยฐานข้อมูล/บริการอื่น
WEB_PORT=8081

WKHTMLTOPDF_BIN="C:\\Program Files\\wkhtmltopdf\\bin\\wkhtmltopdf.exe"
PDFTK_BIN="C:\\Program Files (x86)\\PDFtk Server\\bin\\pdftk.exe"

# จากใน Docker บน Windows/Mac ใช้ host.docker.internal — สอดคล้องกับ d:\docker-db\docker-compose.yml (postgres พอร์ต 5432)
DB_HOST=host.docker.internal
# Postgres: user จาก d:\docker-db คือ admin — ชื่อฐานข้อมูลตามที่ใช้ใน DBeaver
DB_NAME=postgres
DB_USER=admin
DB_PASSWORD=password